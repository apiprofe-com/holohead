# HoloHead settings. install.sh copies this to config.local and fills in a room code.
# Edit config.local (not this file), then quit and restart HoloHead.

# Room code shared with the phone. Keep it private: anyone with it can call the head.
ROOM=""

# Code for the office hours student link (class.html?c=CODE). Students get only this one,
# never the room code. Add it to the HOLOHEAD_ROOMS repo secret so students can use the relay.
CLASS=""

# Your name as students see it in office hours and the chat, e.g. "Ms. Rivera".
TEACHER=""

# Where the web pages live: your copy's GitHub Pages address, e.g.
# "https://yourname.github.io/holohead". install.sh fills this in from your copy.
BASE_URL=""

# Leave empty to auto-detect. Set the full path if Chrome is somewhere unusual.
CHROME_APP=""

# Leave empty to auto-detect the projector screen. Otherwise "x,y" of its top-left corner,
# e.g. "-1920,455" for a 1080p screen placed to the left of a 27" iMac.
PROJ_POS=""

# The caller on the iMac screen too: "window" (big window; double-click it for full screen),
# "fullscreen" (takes over the iMac screen), or "off".
VIEWER="window"

# Optional relay for strict networks (free tier from Metered or Cloudflare).
TURN_URLS=""
TURN_USER=""
TURN_PASS=""
# 1 = always use the relay (testing only)
FORCE_RELAY=0
